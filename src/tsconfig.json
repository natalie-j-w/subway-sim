{
  "compilerOptions": {
    "target": "ESNEXT",
    "module": "es2020",
    "lib": ["ES2020", "DOM"],
    "sourceMap": true,
    "outDir": "../out",
    "moduleDetection": "force",
    "skipLibCheck": true
    },
    
  "typedocOptions": {
    "entryPoints": [
      "*.ts"
    ],
    "out": "../docs"
  },
}